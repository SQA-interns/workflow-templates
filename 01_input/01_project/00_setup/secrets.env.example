# Every secret, key, account or external service credential the project needs.
# Owner: Architect. Agent: read-only.
# The human copies this file to .env (ignored by git) and fills the values; the agent checks .env in phase 0.
# Above each key, one comment line: purpose; environments; provided | test-mode only | not needed.

# PostgreSQL password of the application user; local, staging, production (test uses Testcontainers); provided
DB_PASSWORD=

# Firebase service account JSON (path to the file) for the Admin SDK: deleting Firebase accounts (US-021); staging, production (the emulator needs none in local and test); not needed until increment 2
FIREBASE_SERVICE_ACCOUNT_FILE=
