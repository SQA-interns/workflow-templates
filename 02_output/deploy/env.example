# Settings of one staging or production environment (environments.md "Configuration").
# Copy to <environment>.env next to this file (ignored by git), fill every value, keep it readable only by the operator.

# staging | production; also names the compose project (kontakti-staging, kontakti-production)
DEPLOY_ENV=staging
# Image tag built by ../scripts/build-images.sh (the git commit, e.g. 5cedfcc)
RELEASE_TAG=
# Public host name without scheme; APP_PUBLIC_URL becomes https://<APP_DOMAIN> (CORS, Invitation links)
APP_DOMAIN=
# Directory holding fullchain.pem and privkey.pem for APP_DOMAIN, readable by uid 101 (nginx)
TLS_DIR=
# Host ports of the proxy
HTTP_PORT=80
HTTPS_PORT=443

# Secret: PostgreSQL password of the application user
DB_PASSWORD=
# Secret: path on the host of the Firebase service account JSON of this environment's project, readable by the container user
FIREBASE_SERVICE_ACCOUNT_FILE=

# Firebase project of this environment (not secret, but per environment)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=

RATE_LIMIT_PER_MINUTE=100
LOG_LEVEL=INFO

# Backups (../scripts/backup.sh): a directory that is NOT on the database host's disk (mounted remote storage)
BACKUP_DIR=
